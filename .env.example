SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANONYMOUS_COOKIE_SECRET=
ADMIN_ACCESS_KEY=
# Optional direct connection for yarn db:migrate; never exposed to the app browser.
DATABASE_URL=
# Optional metadata providers. Media rights must be reviewed separately.
TMDB_API_KEY=
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TMDB images: noncommercial for a free launch, or licensed with a separate commercial agreement.
TMDB_IMAGE_USAGE=
# Identify the application/contact to Wikimedia and MusicBrainz.
SOURCE_USER_AGENT=
# Refresh source content after serving cached puzzles (daily, while the application receives traffic).
SOURCE_SYNC_ENABLED=false
# Optional server error reporting endpoint; omit to use redacted JSON logs.
MONITORING_ENDPOINT=
